# Optional Gemini API key for server-side AI recommendations. Leave blank if unused.
GEMINI_API_KEY=""

# Express server port (default: 3000)
PORT="3000"

# Set a strong, unique password in your local .env / hosting environment.
# Do not commit .env. Note: server.ts currently retains an original fallback password;
# do not expose the backend publicly until that fallback is removed and reviewed.
ADMIN_PASSWORD=""
